{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "image": "latest" },
      "android": { "image": "latest", "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": { "image": "latest" },
      "android": { "image": "latest" }
    }
  },
  "submit": {
    "production": {}
  }
}
